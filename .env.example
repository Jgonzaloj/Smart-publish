# Copia este archivo a .env y ajusta los valores

# Cadena de conexión a PostgreSQL
DATABASE_URL="postgresql://app_user:cambia-esto@localhost:5432/creditos_db?schema=public"

# Secreto para firmar los JWT (usa un valor largo y aleatorio en producción)
JWT_SECRET="cambia-este-secreto-en-produccion"

PORT=3000

# Modo demo sin PostgreSQL: SOLO para probar la interfaz sin instalar una base
# de datos. En este modo NO existe aislamiento real entre empresas (no hay RLS).
# NUNCA definas esta variable como "true" en un entorno de producción real.
# Déjala comentada/ausente en cualquier despliegue con datos reales.
# ALLOW_MEMORY_MODE=true
