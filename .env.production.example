# =================================================================
# CONFIGURACIÓN DE PRODUCCIÓN - CREDIYA SAAS
# =================================================================

# 1. Base de Datos PostgreSQL
# Reemplaza con tus credenciales seguras de PostgreSQL
POSTGRES_USER=crediya_app
POSTGRES_PASSWORD=PonUnaContrasenaMuyFuerteYUnica2026!
POSTGRES_DB=crediya_db
POSTGRES_PORT=5432

# Cadena de conexión completa para la aplicación
DATABASE_URL=postgresql://crediya_app:PonUnaContrasenaMuyFuerteYUnica2026!@localhost:5432/crediya_db?schema=public

# 2. Seguridad JWT (Token de Autenticación)
# Genera una clave aleatoria de 64 caracteres mínimo (ej: openssl rand -base64 48)
JWT_SECRET=b63c8a9f4d1e2a0b7c5e8f1a3d6e9c2b5a8d1e4f7a0b3c6e9d2a5f8c1e4b7a0d

# 3. Servidor y Entorno
NODE_ENV=production
PORT=3000

# 4. Orígenes Permitidos CORS
# En producción, especifica tus dominios exactos separados por comas
# Ej: https://miapp.com,https://admin.miapp.com
ALLOWED_ORIGINS=*

# 5. Zona Horaria del Servidor
# Importante para que los cortes de caja y mora ejecuten a la medianoche local
TZ=America/Bogota
