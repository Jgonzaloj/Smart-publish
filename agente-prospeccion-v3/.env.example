# =======================================================
# AGENTE DE PROSPECCIÓN B2B v3.0 - CONFIGURACIÓN
# =======================================================

# Modo de operación (false para modo producción con candados)
USE_MOCK_MODE=false

# Servidor y Dashboard
PORT=3000
HOST=localhost

# Seguridad y Autenticación del Dashboard
ADMIN_USER=admin
ADMIN_PASSWORD=your_secure_password_here

# Google Places API (Skill 1)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# LLM Providers (Skill 3: Cognitive Opportunity Evaluator)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# WhatsApp Cloud API Oficial (Skill 5: Outreach Engine)
WHATSAPP_API_TOKEN=your_meta_whatsapp_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id_here
WHATSAPP_TEMPLATE_NAME=first_contact_audit_v1
WHATSAPP_WEBHOOK_VERIFY_TOKEN=agente_prospeccion_webhook_token_2026
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# Email Outreach (Resend / SMTP) & Inbound Webhook
RESEND_API_KEY=your_resend_api_key_here
RESEND_WEBHOOK_SECRET=your_resend_webhook_secret_here
EMAIL_FROM="Prospección Técnica <auditoria@inversionesvawi.com>"

# Normalización Telefónica (Código de País por Defecto para E.164)
DEFAULT_COUNTRY_CODE=+51

# Motor de Seguimientos Automáticos (Scheduler Cron)
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=60
FOLLOWUP_1_HOURS=48
FOLLOWUP_2_HOURS=72

# Límites y Circuit Breakers (Candados Anti-Baneo)
MAX_BOUNCE_RATE=0.05
MAX_DAILY_WHATSAPP_SENDS=50
MAX_DAILY_EMAIL_SENDS=100
DEFAULT_CLOSER_NAME="Equipo de Cierre Humano"

# Notificaciones y Alertas al Cerrador Humano en Tiempo Real
CLOSER_NOTIFICATION_EMAIL=soporteb2b@inversionesvawi.com
CLOSER_NOTIFICATION_PHONE=51907018071
