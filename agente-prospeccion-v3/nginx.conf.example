# =========================================================================
# Configuración de Nginx para Subdominio (ej: agente.inversionesvawi.com)
# =========================================================================

# Rate Limiting: 5 peticiones por segundo por IP para mitigar fuerza bruta
limit_req_zone $binary_remote_addr zone=one:10m rate=5r/s;

server {
    listen 80;
    server_name agente.inversionesvawi.com; # Reemplazar con tu subdominio real

    # Redirección automática a HTTPS (después de instalar Certbot SSL)
    # return 301 https://$host$request_uri;

    location / {
        # Aplicar Rate Limiting al Dashboard y endpoints
        limit_req zone=one burst=10 nodelay;

        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        
        # Timeouts amplios para auditorías Playwright en segundo plano
        proxy_read_timeout 180s;
        proxy_connect_timeout 180s;
    }
}

